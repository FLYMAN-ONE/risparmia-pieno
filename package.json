{
  "name": "risparmia-pieno",
  "version": "0.1.0",
  "private": true,
  "description": "PWA per trovare i distributori di carburante più economici, con dati MIMIT. La posizione non lascia il telefono.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
