    "test:watch": "vitest",
    "cucina": "node cucina/src/cucina.ts",
    "campionario": "vite --host"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  },
  "dependencies": {
    "maplibre-gl": "6.19.0"
  }
}
